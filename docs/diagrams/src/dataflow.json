  "cards": [
    {
      "dot": "emerald",
      "title": "单一写点",
      "items": [
        "只有事件处理会改 state，渲染层永远只读",
        "改完统一走 refreshAll()，不在渲染函数里互相触发",
        "调用链是 DAG，结构上排除递归环"
      ]
    },
    {
      "dot": "cyan",
      "title": "单一刷新入口",
      "items": [
        "refreshAll() 按固定顺序调用各 render*",
        "每个 render* 独立读取最新 state，不依赖调用次序",
        "视图切换只改 VIEW 变量再走同一条刷新路径"
      ]
    },
    {
      "dot": "amber",
      "title": "容错与降级",
      "items": [
        "localStorage 不可用时切换离线提示，页面不崩",
        "解析失败自动回落到种子数据",
        "首次打开预置示例，杜绝空白首屏"
      ]
    }
  ]
}
