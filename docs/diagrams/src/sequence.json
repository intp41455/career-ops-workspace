  "cards": [
    {
      "dot": "emerald",
      "title": "启动只有一条链",
      "items": [
        "loadData 读本地，缺失则注入种子数据后立即落盘",
        "拿到 state 后只调一次 refreshAll()",
        "渲染函数各自读 state，彼此不调用"
      ]
    },
    {
      "dot": "cyan",
      "title": "交互只做两件事",
      "items": [
        "事件委托解析 data-act，改对应 state 字段",
        "saveData() 序列化并给出同步状态反馈",
        "不直接操作 DOM，改完统一刷新"
      ]
    },
    {
      "dot": "amber",
      "title": "重绘路径可控",
      "items": [
        "画布视图额外触发一次 SVG 重绘与计数同步",
        "非画布视图跳过该分支，无多余开销",
        "返回消息弱于请求消息，主路径始终清晰"
      ]
    }
  ]
}
